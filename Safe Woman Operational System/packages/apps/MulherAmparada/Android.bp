android_app {
    name: "MulherAmparada",

    manifest: "app/src/main/AndroidManifest.xml",

    srcs: [
        "app/src/main/java/**/*.java",
        "app/src/main/java/**/*.kt",
        "app/src/main/kotlin/**/*.java",
        "app/src/main/kotlin/**/*.kt",
    ],

    resource_dirs: [
        "app/src/main/res",
    ],

    privileged: true,

    platform_apis: true,
}