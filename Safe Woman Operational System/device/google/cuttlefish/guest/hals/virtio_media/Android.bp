prebuilt_etc {
    name: "com.google.emulated.camera.provider.hal.v4l2.rc",
    src: "com.google.emulated.camera.provider.hal.v4l2.rc",
    installable: false,
}

prebuilt_etc {
    name: "manifest.xml",
    src: "manifest.xml",
    sub_dir: "vintf",
    installable: false,
}

apex {
    name: "com.google.emulated.camera.provider.hal.v4l2",
    manifest: "apex_manifest.json",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    file_contexts: "file_contexts",
    updatable: false,
    vendor: true,
    binaries: [
        "android.hardware.camera.provider-V1-external-service",
    ],
    native_shared_libs: [
        "android.hardware.camera.provider-V1-external-impl",
    ],
    prebuilts: [
        "com.google.emulated.camera.provider.hal.v4l2.rc",
        "manifest.xml",
    ],
}
