<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/recorder_background"
    android:fitsSystemWindows="true">


    <!-- ========================================================= -->
    <!-- CABEÇALHO FIXO                                            -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="24dp"
        android:paddingTop="50dp"
        android:paddingEnd="24dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- TÍTULO -->

        <TextView
            android:id="@+id/title"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Gravador"

            android:textColor="@color/recorder_title"
            android:textSize="32sp"
            android:textStyle="bold"

            android:fontFamily="sans"
            android:includeFontPadding="false" />


        <!-- SUBTÍTULO -->

        <TextView
            android:id="@+id/subtitle"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="Suas gravações"

            android:textColor="@color/recorder_subtitle"
            android:textSize="15sp"

            android:fontFamily="sans"
            android:includeFontPadding="false" />

    </LinearLayout>



    <!-- ========================================================= -->
    <!-- LISTA DE GRAVAÇÕES                                       -->
    <!-- ========================================================= -->

    <!--
        O TAMANHO DA ÁREA É DEFINIDO AQUI.

        Atualmente: 300dp

        Para aumentar:
        400dp

        Para diminuir:
        250dp
    -->

    <ScrollView
        android:id="@+id/scrollView"

        android:layout_width="0dp"
        android:layout_height="330dp"

        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="24dp"

        android:clipToPadding="false"
        android:fillViewport="true"

        android:overScrollMode="never"
        android:scrollbars="none"

        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!--
            OS ITENS DAS GRAVAÇÕES
            SERÃO INSERIDOS AQUI PELO KT
        -->

        <LinearLayout
            android:id="@+id/list"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical" />

    </ScrollView>



    <!-- ========================================================= -->
    <!-- ÁREA DE GRAVAÇÃO                                         -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/recordArea"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:gravity="center"
        android:orientation="vertical"

        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="30dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ===================================================== -->
        <!-- STATUS                                                -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/recordStatus"

            android:layout_width="wrap_content"
            android:layout_height="36dp"

            android:gravity="center"

            android:paddingStart="15dp"
            android:paddingEnd="15dp"

            android:background="@drawable/recorder_status">


            <View
                android:id="@+id/statusDot"

                android:layout_width="7dp"
                android:layout_height="7dp"

                android:layout_marginEnd="8dp"

                android:background="@drawable/recorder_dot" />


            <TextView
                android:id="@+id/statusText"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Pronto para gravar"

                android:textColor="@color/recorder_status_text"
                android:textSize="13sp"

                android:fontFamily="sans"
                android:includeFontPadding="false" />

        </LinearLayout>



        <!-- ===================================================== -->
        <!-- BOTÃO DE GRAVAÇÃO                                    -->
        <!-- ===================================================== -->

        <FrameLayout
            android:id="@+id/recordButtonContainer"

            android:layout_width="112dp"
            android:layout_height="112dp"

            android:layout_marginTop="18dp"

            android:gravity="center"

            android:clickable="true"
            android:focusable="true"

            android:foreground="@drawable/recorder_ripple">


            <!-- ANEL EXTERNO -->

            <View
                android:id="@+id/recordRing"

                android:layout_width="112dp"
                android:layout_height="112dp"

                android:background="@drawable/recorder_ring" />


            <!-- BOTÃO -->

            <ImageView
                android:id="@+id/btnRecord"

                android:layout_width="82dp"
                android:layout_height="82dp"

                android:layout_gravity="center"

                android:background="@drawable/recorder_button"

                android:contentDescription="Gravar"

                android:padding="24dp"

                android:scaleType="centerInside"

                android:src="@drawable/mic"

                android:tint="@color/recorder_mic" />

        </FrameLayout>



        <!-- ===================================================== -->
        <!-- INSTRUÇÃO                                             -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/recordHint"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:text="Toque para gravar"

            android:textColor="@color/recorder_hint"
            android:textSize="13sp"

            android:fontFamily="sans"
            android:includeFontPadding="false" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>