android_app {
    name: "MulherAmparada",

    manifest: "app/src/main/AndroidManifest.xml",

    srcs: [
        "app/src/main/java/**/*.kt",
        "app/src/main/java/**/*.java",
    ],

    resource_dirs: [
        "app/src/main/res",
    ],

    privileged: true,

    platform_apis: true,

    certificate: "platform",

    kotlincflags: [
        "-jvm-target 17",
    ],
}