android_app {
    name: "MulherAmparada",

    manifest: "app/src/main/AndroidManifest.xml",

    srcs: [
        "app/src/main/java/**/*.kt",
        "app/src/main/java/**/*.java",
        "app/src/main/kotlin/**/*.kt",
        "app/src/main/kotlin/**/*.java",
    ],

    resource_dirs: [
        "app/src/main/res",
    ],

    privileged: true,

    sdk_version: "current",

    min_sdk_version: "23",

    kotlincflags: [
        "-jvm-target 17",
    ],

    optimize: {
        enabled: true,
        shrink: true,
        obfuscate: true,
        shrink_resources: true,
        proguard_flags_files: [
            "app/proguard-rules.pro",
        ],
    },
}