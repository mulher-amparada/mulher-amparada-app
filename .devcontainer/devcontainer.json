{
  "name": "Mulher Amparada - Execução Pública",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "Tela do Mulher Amparada",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "echo 'Ambiente AmparadaOS preparado'",
  "postStartCommand": "bash .devcontainer/start-display.sh"
}