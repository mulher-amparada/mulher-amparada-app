<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mulheres.profileadmin">

    <application
        android:allowBackup="false"
        android:label="Mulher Amparada - Administrador do perfil"
        android:supportsRtl="true">

        <activity
            android:name=".ProfileProvisioningActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".MulherAmparadaProfileAdminReceiver"
            android:description="@string/profile_admin_description"
            android:exported="true"
            android:label="@string/profile_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
