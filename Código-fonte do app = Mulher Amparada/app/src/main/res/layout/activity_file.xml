<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#000000"
    android:fitsSystemWindows="true">


    <!-- ========================================================= -->
    <!-- TOPO                                                     -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/header"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="26dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ===================================================== -->
        <!-- TÍTULO + BOTÃO DE ARMAZENAMENTO                     -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"

            android:orientation="horizontal"
            android:gravity="center_vertical">


            <TextView
                android:id="@+id/title"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Arquivos"

                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"

                android:fontFamily="sans"
                android:includeFontPadding="false" />


            <ImageButton
                android:id="@+id/storageButton"

                android:layout_width="48dp"
                android:layout_height="48dp"

                android:layout_marginStart="8dp"

                android:background="@drawable/bg_storage_button"

                android:padding="11dp"

                android:src="@drawable/ic_storage_internal"

                android:tint="#FFFFFF"

                android:contentDescription="Trocar armazenamento"

                android:clickable="true"
                android:focusable="true"

                android:scaleType="centerInside"

                android:stateListAnimator="@null" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- CAMINHO                                               -->
        <!-- ===================================================== -->

        <HorizontalScrollView
            android:id="@+id/pathScroll"

            android:layout_width="match_parent"
            android:layout_height="40dp"

            android:layout_marginTop="2dp"

            android:fillViewport="false"

            android:scrollbars="none"

            android:overScrollMode="never"

            android:fadingEdge="none">


            <TextView
                android:id="@+id/pathText"

                android:layout_width="wrap_content"
                android:layout_height="match_parent"

                android:gravity="center_vertical"

                android:text="Armazenamento interno"

                android:textColor="#858585"
                android:textSize="13sp"

                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="none"

                android:fontFamily="sans"
                android:includeFontPadding="false" />

        </HorizontalScrollView>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- QUANTIDADE DE ITENS                                      -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/itemCount"

        android:layout_width="0dp"
        android:layout_height="42dp"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"

        android:gravity="center_vertical"

        android:text="0 itens"

        android:textColor="#8A8A8A"
        android:textSize="14sp"

        android:fontFamily="sans"
        android:includeFontPadding="false"

        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================================= -->
    <!-- LISTA DE ARQUIVOS                                        -->
    <!-- ========================================================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:clipToPadding="false"

        android:nestedScrollingEnabled="true"

        android:overScrollMode="never"
        android:scrollbars="none"

        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="24dp"

        app:layout_constraintTop_toBottomOf="@id/itemCount"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>